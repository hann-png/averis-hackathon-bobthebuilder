# Environment Configuration for Shipping Document Verification Pipeline

# Gemini API Key: Primary path for email classification, canonical field extraction, and discrepancy explanations
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional: Custom Data and Submission Paths
SDOC_DATA_DIR="data"
SDOC_SUBMISSION_FILE="submission.json"

# Server / Port configuration
PORT=8080
HOST="0.0.0.0"

# Optional: Automatic Mismatch Email Notification Configuration
# When enabled, the pipeline generates discrepancy draft notifications for confirmed mismatches.
BOB_AUTO_EMAIL_ENABLED="false"

# CRITICAL SAFETY RAIL:
# Real outbound SMTP email transmission is structurally blocked by default to ensure
# that sample addresses from datasets are NEVER contacted under any circumstances.
# Both actually_send=True AND BOB_ALLOW_REAL_SEND=true must be set for live transmission.
# By default, all generated notifications are safely saved locally to testing_generated_emails/.
# BOB_ALLOW_REAL_SEND="false"

# Optional SMTP Settings (Only evaluated if BOB_ALLOW_REAL_SEND="true")
# BOB_SMTP_HOST="smtp.example.com"
# BOB_SMTP_PORT="587"
# BOB_SMTP_USERNAME=""
# BOB_SMTP_PASSWORD=""
# BOB_SMTP_FROM=""

